#include <windows.h>
1 ICON "@DANMAX_ICON@"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@DANMAX_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DanmaX\0"
            VALUE "ProductName", "DanmaX\0"
            VALUE "FileVersion", "@DANMAX_DISPLAY_VERSION@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "OriginalFilename", "DanmaX.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
