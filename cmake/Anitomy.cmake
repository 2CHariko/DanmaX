function(danmax_require_anitomy)
    if(TARGET danmax_anitomy)
        return()
    endif()
    file(READ "${CMAKE_SOURCE_DIR}/toolchain/anitomy.lock.json" lock)
    string(JSON directory GET "${lock}" sourceDirectory)
    file(SHA256 "${CMAKE_SOURCE_DIR}/toolchain/anitomy.lock.json" lock_hash)
    set(root "${CMAKE_SOURCE_DIR}/.deps/anitomy")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_SOURCE_DIR}/toolchain/anitomy.lock.json" "${root}/.prepared-lock")
    if(NOT EXISTS "${root}/.prepared-lock")
        message(FATAL_ERROR "Prepare locked Anitomy explicitly: scripts/prepare-anitomy.ps1 (build stays offline)")
    endif()
    file(READ "${root}/.prepared-lock" prepared)
    string(STRIP "${prepared}" prepared)
    string(TOUPPER "${prepared}" prepared)
    string(TOUPPER "${lock_hash}" lock_hash)
    if(NOT prepared STREQUAL lock_hash)
        message(FATAL_ERROR "Anitomy lock changed; run scripts/prepare-anitomy.ps1")
    endif()
    set(sources)
    foreach(name anitomy element keyword parser parser_helper parser_number string token tokenizer)
        list(APPEND sources "${root}/${directory}/anitomy/${name}.cpp")
    endforeach()
    add_library(danmax_anitomy STATIC ${sources})
    set_target_properties(danmax_anitomy PROPERTIES AUTOMOC OFF)
    target_include_directories(danmax_anitomy PUBLIC "${root}/${directory}")
    danmaku_compile_options(danmax_anitomy)
endfunction()
